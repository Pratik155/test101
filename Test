import pandas as pd
from catboost import CatBoostClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
from sklearn.feature_extraction.text import TfidfVectorizer
import os
import pickle

# Step 1: Create directory to store models
os.makedirs("artifacts", exist_ok=True)

# Step 2: Load and preprocess data
df = pd.read_csv('your_data.csv')  # Replace with your actual CSV file

# Vectorize the summary column
vectorizer = TfidfVectorizer(max_features=5000)  # You can adjust max_features as needed
X = vectorizer.fit_transform(df['summary']).toarray()

# Save the vectorizer to use in production
with open("artifacts/vectorizer.pkl", "wb") as f:
    pickle.dump(vectorizer, f)

# Labels
y_K3 = df['K3']

# Step 3: Train K3 Classifier
# Train-test split
X_train_K3, X_test_K3, y_train_K3, y_test_K3 = train_test_split(X, y_K3, test_size=0.2, random_state=42)

# Initialize and train the K3 model
model_K3 = CatBoostClassifier(iterations=100, depth=5, learning_rate=0.1, verbose=0)
model_K3.fit(X_train_K3, y_train_K3)

# Save the K3 model
with open("artifacts/K3_classifier.pkl", "wb") as f:
    pickle.dump(model_K3, f)

# Evaluate the K3 model
y_pred_K3 = model_K3.predict(X_test_K3)
accuracy_K3 = accuracy_score(y_test_K3, y_pred_K3)
precision_K3 = precision_score(y_test_K3, y_pred_K3, average='weighted', zero_division=0)
recall_K3 = recall_score(y_test_K3, y_pred_K3, average='weighted')
f1_K3 = f1_score(y_test_K3, y_pred_K3, average='weighted')

print(f"K3 Classifier - Accuracy: {accuracy_K3}, Precision: {precision_K3}, Recall: {recall_K3}, F1 Score: {f1_K3}")

# Step 4: Train K4 Classifiers for Each K3
K3_values = df['K3'].unique()

for K3 in K3_values:
    sub_df = df[df['K3'] == K3]
    if sub_df['K4'].nunique() > 1:  # Check if there are enough records for multiple classes
        X_sub = vectorizer.transform(sub_df['summary']).toarray()  # Vectorize the summaries for this subset
        y_K4 = sub_df['K4']
        
        # Train-test split
        X_train_K4, X_test_K4, y_train_K4, y_test_K4 = train_test_split(X_sub, y_K4, test_size=0.2, random_state=42)
        
        # Initialize and train the K4 model
        model_K4 = CatBoostClassifier(iterations=100, depth=5, learning_rate=0.1, verbose=0)
        model_K4.fit(X_train_K4, y_train_K4)
        
        # Save the K4 model
        model_name = f"artifacts/{K3.replace(' ', '_')}_K4_predictor.pkl"
        with open(model_name, "wb") as f:
            pickle.dump(model_K4, f)
        
        # Evaluate the K4 model
        y_pred_K4 = model_K4.predict(X_test_K4)
        accuracy_K4 = accuracy_score(y_test_K4, y_pred_K4)
        precision_K4 = precision_score(y_test_K4, y_pred_K4, average='weighted', zero_division=0)
        recall_K4 = recall_score(y_test_K4, y_pred_K4, average='weighted')
        f1_K4 = f1_score(y_test_K4, y_pred_K4, average='weighted')

        print(f"{K3} - K4 Classifier - Accuracy: {accuracy_K4}, Precision: {precision_K4}, Recall: {recall_K4}, F1 Score: {f1_K4}")
    else:
        print(f"Skipping {K3} as it does not have enough unique K4 classes.")
