    'own', 'same', 'so', 'than', 'too', 'very', 's', 't', 'can', 'will', 'just', 
    'don', 'should', 'now'
])

def preprocess_text(text):
    # Lowercase text
    text = text.lower()
    # Remove punctuation and special characters
    text = re.sub(r'[^\w\s]', '', text)
    # Remove stop words
    text = ' '.join(word for word in text.split() if word not in stopwords)
    return text

# Load your data
df = pd.read_csv('your_data.csv')  # Replace with your actual data source

# Display the first few rows
print(df.head())

# Check the distribution of journey names
print(df['journey'].value_counts())

# Sample the data to make sure each journey is equally represented
min_count = df['journey'].value_counts().min()
sampled_df = df.groupby('journey').apply(lambda x: x.sample(min_count)).reset_index(drop=True)

# Verify the new distribution
print(sampled_df['journey'].value_counts())

# Apply preprocessing to the summary column
sampled_df['summary'] = sampled_df['summary'].apply(preprocess_text)

# Shuffle and split the data
train_df, test_df = train_test_split(sampled_df, test_size=0.25, random_state=42)

# Separate features and target
X_train = train_df['summary']
y_train = train_df['journey']
X_test = test_df['summary']
y_test = test_df['journey']

# TF-IDF Vectorization
vectorizer = TfidfVectorizer()

# Fit and transform the training data
X_train_tfidf = vectorizer.fit_transform(X_train)

# Transform the test data
X_test_tfidf = vectorizer.transform(X_test)

# Label Encoding
label_encoder = LabelEncoder()
y_train_encoded = label_encoder.fit_transform(y_train)

# Use a mapping for unseen labels
known_classes = set(label_encoder.classes_)

def handle_unseen_labels(preds, known_classes):
    """ Replace unseen labels with a default label """
    default_label = len(known_classes)  # Assuming the default label is out of known classes range
    return [default_label if label not in known_classes else label for label in preds]

# Initialize classifiers
classifiers = {
    'Naive Bayes': MultinomialNB(),
    'Logistic Regression': LogisticRegression(max_iter=1000),
    'SVM': SVC(),
    'Random Forest': RandomForestClassifier(),
    'K-Nearest Neighbors': KNeighborsClassifier()
}

# Train and evaluate each classifier
for name, clf in classifiers.items():
    # Train the classifier
    clf.fit(X_train_tfidf, y_train_encoded)
    
    # Predict on the test set
    y_pred_encoded = clf.predict(X_test_tfidf)
    
    # Handle unseen labels during prediction
    y_pred_encoded_safe = handle_unseen_labels(y_pred_encoded, known_classes)
    
    # Convert encoded predictions back to original category names
    y_pred = label_encoder.inverse_transform(y_pred_encoded_safe)
    
    # Convert y_test to original labels and handle any unseen test labels
    y_test_encoded_safe = handle_unseen_labels(y_test.map(lambda x: label_encoder.transform([x])[0]).values, known_classes)
    
    # Calculate accuracy
    accuracy = accuracy_score(y_test_encoded_safe, y_pred_encoded_safe)
    print(f'{name} Accuracy: {accuracy:.2f}')
    
    # Display a sample of predictions vs actual values
    sample_size = 10
    sample_df = pd.DataFrame({
        'Actual': y_test.head(sample_size),
        'Predicted': y_pred[:sample_size]
    })
    print(f'\nSample predictions for {name}:\n', sample_df)
