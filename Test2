import pandas as pd
import pickle

# Step 1: Load the vectorizer and trained models
with open("artifacts/vectorizer.pkl", "rb") as f:
    vectorizer = pickle.load(f)

with open("artifacts/K3_classifier.pkl", "rb") as f:
    model_K3 = pickle.load(f)

# Step 2: Create a test DataFrame with K3 and K4 for predictions
test_data = {
    "summary": [
        "Customer wants to open a new savings account",
        "Request for credit card closure",
        "Inquire about savings account balance",
        "Issue with credit card transaction",
        "Closing a savings account"
    ],
    "K3": ["", "", "", "", ""],  # To be predicted
    "K4": ["", "", "", "", ""]   # To be predicted
}

test_df = pd.DataFrame(test_data)

# Step 3: Vectorize the summaries
X_test = vectorizer.transform(test_df['summary']).toarray()

# Step 4: Predict K3 using the K3 model
predicted_K3 = model_K3.predict(X_test)
test_df['K3'] = predicted_K3

# Step 5: Predict K4 based on the predicted K3
for i, row in test_df.iterrows():
    K3_pred = row['K3']
    model_path = f"artifacts/{K3_pred.replace(' ', '_')}_K4_predictor.pkl"
    
    try:
        # Load the corresponding K4 model
        with open(model_path, "rb") as f:
            model_K4 = pickle.load(f)
        
        # Predict K4
        X_single = X_test[i].reshape(1, -1)
        predicted_K4 = model_K4.predict(X_single)
        test_df.at[i, 'K4'] = predicted_K4[0]
    
    except FileNotFoundError:
        test_df.at[i, 'K4'] = "No model found for this K3"

# Step 6: Display the final predictions
print(test_df)
